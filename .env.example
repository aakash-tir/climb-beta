# Copy to .env (gitignored) and fill in. Never commit real values.

# Roboflow (free account) for data/download_roboflow.py
ROBOFLOW_API_KEY=

# Hugging Face token with write access to the private Basecamp dataset repo
HF_TOKEN=
# e.g. <your-hf-user>/basecamp-holds (private)
HF_DATASET_REPO=

# Label Studio admin for labelling/docker-compose.yml
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=
# Personal access token from Label Studio (Account & Settings) for the ML backend
LABEL_STUDIO_API_KEY=

# Detector weights for the app and eval (local path or hf://<repo>/<file>)
CLIMB_DETECTOR_WEIGHTS=weights/detector.pt
CLIMB_COLOUR_WEIGHTS=
